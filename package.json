{
  "name": "pulplog",
  "version": "3.0.0",
  "description": "PulpLog — visor de logs de escritorio con coloreado de stack traces",
  "author": "LindeCode",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && node scripts/run-electron.js\"",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node tests/electron-smoke.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^8.0.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "vite": "^8.0.14",
    "wait-on": "^7.0.0"
  },
  "build": {
    "appId": "com.lindecode.pulplog",
    "productName": "PulpLog",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "fileAssociations": [
      {
        "ext": "log",
        "name": "Log File",
        "description": "Archivo de log",
        "role": "Viewer"
      },
      {
        "ext": "out",
        "name": "Output File",
        "description": "Archivo de salida",
        "role": "Viewer"
      },
      {
        "ext": "txt",
        "name": "Text File",
        "description": "Archivo de texto",
        "role": "Viewer"
      }
    ]
  }
}
